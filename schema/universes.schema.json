{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://comic-organizer.local/schema/universes.schema.json",
	"title": "Spider-Man Universe Database",
	"type": "object",
	"required": ["schemaVersion", "researchCutoff", "records"],
	"additionalProperties": false,
	"properties": {
		"schemaVersion": { "type": "string" },
		"researchCutoff": { "type": "string", "format": "date" },
		"records": { "type": "array", "items": { "$ref": "#/$defs/universe" } }
	},
	"$defs": {
		"universeId": { "type": "string", "pattern": "^UNI-[0-9]{6}$" },
		"sourceId": { "type": "string", "pattern": "^SRC-[0-9]{6}$" },
		"reviewId": { "type": "string", "pattern": "^REV-[0-9]{6}$" },
		"verificationStatus": {
			"type": "string",
			"enum": ["Verified", "Partially Verified", "Conflicting Sources", "Manual Review", "Unverified"]
		},
		"universe": {
			"type": "object",
			"required": ["id", "name", "displayName", "aliases", "sourceIds", "verificationStatus"],
			"additionalProperties": false,
			"properties": {
				"id": { "$ref": "#/$defs/universeId" },
				"name": { "type": "string", "minLength": 1 },
				"displayName": { "type": "string", "minLength": 1 },
				"aliases": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
				"description": { "type": ["string", "null"] },
				"sourceIds": { "type": "array", "items": { "$ref": "#/$defs/sourceId" }, "uniqueItems": true },
				"verificationStatus": { "$ref": "#/$defs/verificationStatus" },
				"confidence": { "type": "number", "minimum": 0, "maximum": 1 },
				"lastVerified": { "type": ["string", "null"], "format": "date" },
				"reviewIds": { "type": "array", "items": { "$ref": "#/$defs/reviewId" }, "uniqueItems": true }
			}
		}
	}
}
