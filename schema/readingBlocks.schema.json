{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://comic-organizer.local/schema/readingBlocks.schema.json",
	"title": "Spider-Man Reading Block Database",
	"type": "object",
	"required": ["schemaVersion", "researchCutoff", "records"],
	"additionalProperties": false,
	"properties": {
		"schemaVersion": { "type": "string" },
		"researchCutoff": { "type": "string", "format": "date" },
		"records": { "type": "array", "items": { "$ref": "#/$defs/readingBlock" } }
	},
	"$defs": {
		"blockId": { "type": "string", "pattern": "^BLK-[0-9]{6}$" },
		"issueId": { "type": "string", "pattern": "^ISS-[0-9]{6}$" },
		"eventId": { "type": ["string", "null"], "pattern": "^EVT-[0-9]{6}$" },
		"universeId": { "type": "string", "pattern": "^UNI-[0-9]{6}$" },
		"sourceId": { "type": "string", "pattern": "^SRC-[0-9]{6}$" },
		"reviewId": { "type": "string", "pattern": "^REV-[0-9]{6}$" },
		"readingStyle": { "type": "string", "enum": ["Solo", "Recommended Interleave", "Required Interleave", "Event"] },
		"verificationStatus": {
			"type": "string",
			"enum": ["Verified", "Partially Verified", "Conflicting Sources", "Manual Review", "Unverified"]
		},
		"blockType": {
			"type": "string",
			"enum": ["Single Issue", "Story Arc", "Miniseries", "Crossover", "Event", "Status-Quo Transition", "Run Segment"]
		},
		"readingBlock": {
			"type": "object",
			"required": [
				"id",
				"title",
				"issueIds",
				"orderedIssueIds",
				"readingStyle",
				"blockType",
				"continuityId",
				"previousBlockIds",
				"nextBlockIds",
				"requiredBeforeBlockIds",
				"recommendedBeforeBlockIds",
				"placementReason",
				"sourceIds",
				"verificationStatus",
				"confidence"
			],
			"additionalProperties": false,
			"properties": {
				"id": { "$ref": "#/$defs/blockId" },
				"title": { "type": "string", "minLength": 1 },
				"issueIds": { "type": "array", "items": { "$ref": "#/$defs/issueId" }, "uniqueItems": true },
				"orderedIssueIds": { "type": "array", "items": { "$ref": "#/$defs/issueId" }, "uniqueItems": true },
				"readingStyle": { "$ref": "#/$defs/readingStyle" },
				"blockType": { "$ref": "#/$defs/blockType" },
				"continuityId": { "$ref": "#/$defs/universeId" },
				"eventId": { "$ref": "#/$defs/eventId" },
				"previousBlockIds": { "type": "array", "items": { "$ref": "#/$defs/blockId" }, "uniqueItems": true },
				"nextBlockIds": { "type": "array", "items": { "$ref": "#/$defs/blockId" }, "uniqueItems": true },
				"requiredBeforeBlockIds": { "type": "array", "items": { "$ref": "#/$defs/blockId" }, "uniqueItems": true },
				"recommendedBeforeBlockIds": { "type": "array", "items": { "$ref": "#/$defs/blockId" }, "uniqueItems": true },
				"placementReason": { "type": "array", "items": { "type": "string" } },
				"sourceIds": { "type": "array", "items": { "$ref": "#/$defs/sourceId" }, "uniqueItems": true },
				"verificationStatus": { "$ref": "#/$defs/verificationStatus" },
				"confidence": { "type": "number", "minimum": 0, "maximum": 1 },
				"lastVerified": { "type": ["string", "null"], "format": "date" },
				"reviewIds": { "type": "array", "items": { "$ref": "#/$defs/reviewId" }, "uniqueItems": true }
			}
		}
	}
}
