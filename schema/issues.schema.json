{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://comic-organizer.local/schema/issues.schema.json",
	"title": "Spider-Man Issue Database",
	"type": "object",
	"required": ["schemaVersion", "researchCutoff", "records"],
	"additionalProperties": false,
	"properties": {
		"schemaVersion": { "type": "string" },
		"researchCutoff": { "type": "string", "format": "date" },
		"records": { "type": "array", "items": { "$ref": "#/$defs/issue" } }
	},
	"$defs": {
		"issueId": { "type": "string", "pattern": "^ISS-[0-9]{6}$" },
		"seriesId": { "type": "string", "pattern": "^SER-[0-9]{6}$" },
		"arcId": { "type": "string", "pattern": "^ARC-[0-9]{6}$" },
		"blockId": { "type": "string", "pattern": "^BLK-[0-9]{6}$" },
		"eventId": { "type": "string", "pattern": "^EVT-[0-9]{6}$" },
		"universeId": { "type": "string", "pattern": "^UNI-[0-9]{6}$" },
		"sourceId": { "type": "string", "pattern": "^SRC-[0-9]{6}$" },
		"reviewId": { "type": "string", "pattern": "^REV-[0-9]{6}$" },
		"nullableIssueId": { "type": ["string", "null"], "pattern": "^ISS-[0-9]{6}$" },
		"datePrecision": { "type": "string", "enum": ["day", "month", "year", "unknown"] },
		"readingStyle": { "type": "string", "enum": ["Solo", "Recommended Interleave", "Required Interleave", "Event"] },
		"importance": { "type": "string", "enum": ["Core", "Recommended", "Optional"] },
		"verificationStatus": {
			"type": "string",
			"enum": ["Verified", "Partially Verified", "Conflicting Sources", "Manual Review", "Unverified"]
		},
		"issueType": {
			"type": "string",
			"enum": [
				"Standard",
				"Annual",
				"One-Shot",
				"Special",
				"Giant-Size",
				"Graphic Novel",
				"Digital Chapter",
				"Infinity Comic",
				"FCBD",
				"Anthology Story"
			]
		},
		"publicationFormat": { "type": "string", "enum": ["Print", "Digital", "Digital First", "Infinity Comic", "Original Graphic Novel"] },
		"issue": {
			"type": "object",
			"required": [
				"id",
				"seriesId",
				"issueNumber",
				"releaseDate",
				"releaseDatePrecision",
				"continuityId",
				"leadCharacterIds",
				"storyArcIds"
			],
			"additionalProperties": false,
			"properties": {
				"id": { "$ref": "#/$defs/issueId" },
				"seriesId": { "$ref": "#/$defs/seriesId" },
				"issueNumber": { "type": "string", "minLength": 1 },
				"displayIssueNumber": { "type": "string", "minLength": 1 },
				"legacyNumber": { "type": ["string", "null"] },
				"issueType": { "$ref": "#/$defs/issueType" },
				"title": { "type": ["string", "null"] },
				"subtitle": { "type": ["string", "null"] },
				"releaseDate": { "type": ["string", "null"] },
				"releaseDatePrecision": { "$ref": "#/$defs/datePrecision" },
				"coverDate": { "type": ["string", "null"] },
				"coverDatePrecision": { "$ref": "#/$defs/datePrecision" },
				"pageCount": { "type": ["integer", "null"], "minimum": 1 },
				"continuityId": { "$ref": "#/$defs/universeId" },
				"leadCharacterIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
				"storyArcIds": { "type": "array", "items": { "$ref": "#/$defs/arcId" }, "uniqueItems": true },
				"readingBlockIds": { "type": "array", "items": { "$ref": "#/$defs/blockId" }, "uniqueItems": true },
				"eventIds": { "type": "array", "items": { "$ref": "#/$defs/eventId" }, "uniqueItems": true },
				"publicationOrder": { "type": ["integer", "null"], "minimum": 1 },
				"recommendedReadingOrder": { "type": ["integer", "null"], "minimum": 1 },
				"readingStyle": { "$ref": "#/$defs/readingStyle" },
				"importance": { "$ref": "#/$defs/importance" },
				"requiredBeforeIssueIds": { "type": "array", "items": { "$ref": "#/$defs/issueId" }, "uniqueItems": true },
				"recommendedBeforeIssueIds": { "type": "array", "items": { "$ref": "#/$defs/issueId" }, "uniqueItems": true },
				"continuedFromIssueId": { "$ref": "#/$defs/nullableIssueId" },
				"continuesInIssueId": { "$ref": "#/$defs/nullableIssueId" },
				"referencesIssueIds": { "type": "array", "items": { "$ref": "#/$defs/issueId" }, "uniqueItems": true },
				"containsOriginalMaterial": { "type": "boolean" },
				"originalPublicationFormat": { "$ref": "#/$defs/publicationFormat" },
				"notes": { "type": "array", "items": { "type": "string" } },
				"sourceIds": { "type": "array", "items": { "$ref": "#/$defs/sourceId" }, "uniqueItems": true },
				"verificationStatus": { "$ref": "#/$defs/verificationStatus" },
				"confidence": { "type": "number", "minimum": 0, "maximum": 1 },
				"lastVerified": { "type": ["string", "null"], "format": "date" },
				"reviewIds": { "type": "array", "items": { "$ref": "#/$defs/reviewId" }, "uniqueItems": true }
			}
		}
	}
}
