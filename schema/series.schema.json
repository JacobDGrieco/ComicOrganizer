{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://comic-organizer.local/schema/series.schema.json",
	"title": "Spider-Man Series Database",
	"type": "object",
	"required": ["schemaVersion", "researchCutoff", "records"],
	"additionalProperties": false,
	"properties": {
		"schemaVersion": { "type": "string" },
		"researchCutoff": { "type": "string", "format": "date" },
		"records": {
			"type": "array",
			"items": { "$ref": "#/$defs/series" }
		}
	},
	"$defs": {
		"id": { "type": "string", "pattern": "^SER-[0-9]{6}$" },
		"sourceId": { "type": "string", "pattern": "^SRC-[0-9]{6}$" },
		"issueId": { "type": "string", "pattern": "^ISS-[0-9]{6}$" },
		"universeId": { "type": "string", "pattern": "^UNI-[0-9]{6}$" },
		"seriesId": { "type": ["string", "null"], "pattern": "^SER-[0-9]{6}$" },
		"reviewId": { "type": "string", "pattern": "^REV-[0-9]{6}$" },
		"verificationStatus": {
			"type": "string",
			"enum": ["Verified", "Partially Verified", "Conflicting Sources", "Manual Review", "Unverified"]
		},
		"datePrecision": { "type": "string", "enum": ["day", "month", "year", "unknown"] },
		"publicationType": {
			"type": "string",
			"enum": [
				"Ongoing",
				"Limited Series",
				"Miniseries",
				"Maxiseries",
				"Annual",
				"One-Shot",
				"Special",
				"Graphic Novel",
				"Digital First",
				"Infinity Comic",
				"Event",
				"Giant-Size",
				"FCBD",
				"Anthology"
			]
		},
		"status": { "type": "string", "enum": ["Completed", "Ongoing", "Cancelled", "Hiatus", "Unknown"] },
		"series": {
			"type": "object",
			"required": [
				"id",
				"title",
				"leadCharacterIds",
				"continuityId",
				"startDate",
				"startDatePrecision",
				"endDate",
				"endDatePrecision"
			],
			"additionalProperties": false,
			"properties": {
				"id": { "$ref": "#/$defs/id" },
				"title": { "type": "string", "minLength": 1 },
				"sortTitle": { "type": "string", "minLength": 1 },
				"volume": { "type": ["integer", "string", "null"] },
				"displayVolume": { "type": ["string", "null"] },
				"publicationType": { "$ref": "#/$defs/publicationType" },
				"status": { "$ref": "#/$defs/status" },
				"publisher": { "type": "string", "minLength": 1 },
				"imprint": { "type": ["string", "null"] },
				"leadCharacterIds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
				"continuityId": { "$ref": "#/$defs/universeId" },
				"startDate": { "type": ["string", "null"] },
				"startDatePrecision": { "$ref": "#/$defs/datePrecision" },
				"endDate": { "type": ["string", "null"] },
				"endDatePrecision": { "$ref": "#/$defs/datePrecision" },
				"issueIds": { "type": "array", "items": { "$ref": "#/$defs/issueId" }, "uniqueItems": true },
				"issueCount": { "type": "integer", "minimum": 0 },
				"bibliographicIssueCount": { "type": ["integer", "null"], "minimum": 0 },
				"numberingSummary": { "type": ["string", "null"] },
				"continuationOfSeriesId": { "$ref": "#/$defs/seriesId" },
				"continuedBySeriesId": { "$ref": "#/$defs/seriesId" },
				"notes": { "type": "array", "items": { "type": "string" } },
				"sourceIds": { "type": "array", "items": { "$ref": "#/$defs/sourceId" }, "uniqueItems": true },
				"verificationStatus": { "$ref": "#/$defs/verificationStatus" },
				"confidence": { "type": "number", "minimum": 0, "maximum": 1 },
				"lastVerified": { "type": ["string", "null"], "format": "date" },
				"reviewIds": { "type": "array", "items": { "$ref": "#/$defs/reviewId" }, "uniqueItems": true }
			}
		}
	}
}
