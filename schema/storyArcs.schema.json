{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://comic-organizer.local/schema/storyArcs.schema.json",
	"title": "Spider-Man Story Arc Database",
	"type": "object",
	"required": ["schemaVersion", "researchCutoff", "records"],
	"additionalProperties": false,
	"properties": {
		"schemaVersion": { "type": "string" },
		"researchCutoff": { "type": "string", "format": "date" },
		"records": { "type": "array", "items": { "$ref": "#/$defs/storyArc" } }
	},
	"$defs": {
		"arcId": { "type": "string", "pattern": "^ARC-[0-9]{6}$" },
		"issueId": { "type": "string", "pattern": "^ISS-[0-9]{6}$" },
		"nullableIssueId": { "type": ["string", "null"], "pattern": "^ISS-[0-9]{6}$" },
		"eventId": { "type": ["string", "null"], "pattern": "^EVT-[0-9]{6}$" },
		"universeId": { "type": "string", "pattern": "^UNI-[0-9]{6}$" },
		"sourceId": { "type": "string", "pattern": "^SRC-[0-9]{6}$" },
		"reviewId": { "type": "string", "pattern": "^REV-[0-9]{6}$" },
		"datePrecision": { "type": "string", "enum": ["day", "month", "year", "unknown"] },
		"readingStyle": { "type": "string", "enum": ["Solo", "Recommended Interleave", "Required Interleave", "Event"] },
		"verificationStatus": {
			"type": "string",
			"enum": ["Verified", "Partially Verified", "Conflicting Sources", "Manual Review", "Unverified"]
		},
		"arcType": {
			"type": "string",
			"enum": [
				"Standalone",
				"Single-Series Arc",
				"Multi-Series Crossover",
				"Event Arc",
				"Loose Thematic Arc",
				"Status-Quo Transition",
				"Unknown"
			]
		},
		"storyArc": {
			"type": "object",
			"required": [
				"id",
				"title",
				"continuityId",
				"startDate",
				"startDatePrecision",
				"issueIds",
				"orderedIssueIds"
			],
			"additionalProperties": false,
			"properties": {
				"id": { "$ref": "#/$defs/arcId" },
				"title": { "type": "string", "minLength": 1 },
				"alternateTitles": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
				"isEditorialTitle": { "type": "boolean" },
				"continuityId": { "$ref": "#/$defs/universeId" },
				"startDate": { "type": ["string", "null"] },
				"startDatePrecision": { "$ref": "#/$defs/datePrecision" },
				"endDate": { "type": ["string", "null"] },
				"endDatePrecision": { "$ref": "#/$defs/datePrecision" },
				"issueIds": { "type": "array", "items": { "$ref": "#/$defs/issueId" }, "uniqueItems": true },
				"orderedIssueIds": { "type": "array", "items": { "$ref": "#/$defs/issueId" }, "uniqueItems": true },
				"readingStyle": { "$ref": "#/$defs/readingStyle" },
				"arcType": { "$ref": "#/$defs/arcType" },
				"eventId": { "$ref": "#/$defs/eventId" },
				"startIssueId": { "$ref": "#/$defs/nullableIssueId" },
				"endIssueId": { "$ref": "#/$defs/nullableIssueId" },
				"summary": { "type": ["string", "null"] },
				"placementNotes": { "type": "array", "items": { "type": "string" } },
				"sourceIds": { "type": "array", "items": { "$ref": "#/$defs/sourceId" }, "uniqueItems": true },
				"verificationStatus": { "$ref": "#/$defs/verificationStatus" },
				"confidence": { "type": "number", "minimum": 0, "maximum": 1 },
				"lastVerified": { "type": ["string", "null"], "format": "date" },
				"reviewIds": { "type": "array", "items": { "$ref": "#/$defs/reviewId" }, "uniqueItems": true }
			}
		}
	}
}
