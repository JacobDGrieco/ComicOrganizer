{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://comic-organizer.local/schema/review.schema.json",
	"title": "Spider-Man Review Item Database",
	"type": "object",
	"required": ["schemaVersion", "researchCutoff", "records"],
	"additionalProperties": false,
	"properties": {
		"schemaVersion": { "type": "string" },
		"researchCutoff": { "type": "string", "format": "date" },
		"records": { "type": "array", "items": { "$ref": "#/$defs/reviewItem" } }
	},
	"$defs": {
		"reviewId": { "type": "string", "pattern": "^REV-[0-9]{6}$" },
		"sourceId": { "type": "string", "pattern": "^SRC-[0-9]{6}$" },
		"entityType": { "type": "string", "enum": ["Series", "Issue", "StoryArc", "ReadingBlock", "Event", "Universe", "Source", "Scope"] },
		"status": { "type": "string", "enum": ["Open", "Resolved", "Deferred", "Rejected"] },
		"priority": { "type": "string", "enum": ["Critical", "High", "Medium", "Low"] },
		"category": {
			"type": "string",
			"enum": [
				"Conflicting Release Date",
				"Conflicting Issue Count",
				"Reading Order Conflict",
				"Scope Decision",
				"Duplicate Candidate",
				"Numbering Question",
				"Arc Boundary",
				"Source Conflict",
				"Missing Source",
				"Other"
			]
		},
		"reviewItem": {
			"type": "object",
			"required": [
				"id",
				"entityType",
				"entityId",
				"category",
				"question",
				"candidateValues",
				"sourceIds",
				"recommendedAction",
				"status",
				"priority",
				"notes"
			],
			"additionalProperties": false,
			"properties": {
				"id": { "$ref": "#/$defs/reviewId" },
				"entityType": { "$ref": "#/$defs/entityType" },
				"entityId": { "type": ["string", "null"] },
				"category": { "$ref": "#/$defs/category" },
				"question": { "type": "string", "minLength": 1 },
				"candidateValues": { "type": "array", "items": { "type": "string" } },
				"sourceIds": { "type": "array", "items": { "$ref": "#/$defs/sourceId" }, "uniqueItems": true },
				"recommendedAction": { "type": "string", "minLength": 1 },
				"status": { "$ref": "#/$defs/status" },
				"priority": { "$ref": "#/$defs/priority" },
				"notes": { "type": "array", "items": { "type": "string" } },
				"resolution": { "type": ["string", "null"] },
				"createdAt": { "type": ["string", "null"], "format": "date" },
				"resolvedAt": { "type": ["string", "null"], "format": "date" }
			}
		}
	}
}
